#!/bin/bash
# Give every workspace its own wallpaper from the active theme.
#
#   workspace-walls daemon    follow workspace switches and show each one's photo
#   workspace-walls shuffle   deal new photos to every workspace (the 15-minute timer)
#   workspace-walls next      a new random photo for the current workspace (the hotkey)
#
# Only acts while the active theme ships a credits.json photo list (Omarchy
# Nigeria does); other themes keep Omarchy's normal single wallpaper.
set -uo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}"
theme="$state/omarchy/current/theme"
map="$state/nigeria-theme/workspace-walls"
mkdir -p "$(dirname "$map")"
touch "$map"

themed() { [[ -f $theme/credits.json ]]; }

photos() {
  find -L "$theme/backgrounds" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -printf '%f\n' | sort
}

current_ws() {
  hyprctl activeworkspace -j | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])'
}

# The map holds one "workspace photo" pair per line.
get() { awk -v w="$1" '$1 == w { print $2; exit }' "$map"; }
put() {
  local tmp
  tmp=$(mktemp "$map.XXXXXX")
  awk -v w="$1" '$1 != w' "$map" >"$tmp"
  printf '%s %s\n' "$1" "$2" >>"$tmp"
  mv -f "$tmp" "$map"
}

# A random photo, avoiding the ones other workspaces already show where possible.
pick() {
  local except=$1 used pool
  used=$(awk -v w="$except" '$1 != w { print $2 }' "$map")
  pool=$(photos | grep -vxF -f <(printf '%s\n' "$used" "$(get "$except")") || true)
  [[ -n $pool ]] || pool=$(photos | grep -vxF "$(get "$except")" || photos)
  shuf -n1 <<<"$pool"
}

show() {
  local ws=$1 photo
  themed || return 0
  photo=$(get "$ws")
  if [[ -z $photo || ! -f $theme/backgrounds/$photo ]]; then
    photo=$(pick "$ws")
    [[ -n $photo ]] || return 0
    put "$ws" "$photo"
  fi
  [[ $(readlink -f "$state/omarchy/current/background") == "$(readlink -f "$theme/backgrounds/$photo")" ]] && return 0
  omarchy theme bg set "$theme/backgrounds/$photo" >/dev/null 2>&1
}

case ${1:-} in
  daemon)
    socket="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
    show "$(current_ws)"
    socat -U - "UNIX-CONNECT:$socket" | while IFS= read -r line; do
      case $line in
        workspacev2'>>'*) id=${line#workspacev2>>}; show "${id%%,*}" ;;
      esac
    done
    ;;
  shuffle)
    themed || exit 0
    : >"$map"
    show "$(current_ws)"
    ;;
  next)
    themed || exit 0
    ws=$(current_ws)
    put "$ws" "$(pick "$ws")"
    show "$ws"
    ;;
  *)
    echo "usage: workspace-walls daemon|shuffle|next" >&2
    exit 1
    ;;
esac
