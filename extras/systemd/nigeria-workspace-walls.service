[Unit]
Description=Give every workspace its own Omarchy Nigeria wallpaper
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/nigeria-workspace-walls daemon
Restart=on-failure
RestartSec=3
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/share/omarchy/bin

[Install]
WantedBy=graphical-session.target
